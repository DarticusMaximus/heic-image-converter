src-tauri/tests/fixtures/*.jpg binary
src-tauri/tests/fixtures/*.gif binary
src-tauri/tests/fixtures/*.webp binary
src-tauri/tests/fixtures/*.tif binary
src-tauri/tests/fixtures/*.tiff binary
src-tauri/tests/fixtures/*.bmp binary
src-tauri/tests/fixtures/*.heic binary
